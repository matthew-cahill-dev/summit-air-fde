# Copy to .env for local dev. Never commit .env.
DATABASE_URL=postgres://localhost:5432/summit_air_dev
# Shared secret Vapi sends as "Authorization: Bearer <value>" (Vapi Bearer Token credential). 16+ chars.
VAPI_TOOL_SECRET=replace-with-a-long-random-string
# Password for the operations console (/dispatch, /calls, ...). 8+ chars. Changing it signs everyone out.
DASHBOARD_PASSWORD=replace-me-please
# Public base URL of this app (used in Vapi tool configs).
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York
# Optional E.164 number for on-call human transfer, e.g. +17185550100.
# Read by the app (triage offers transfer) AND by `npm run vapi:sync` (attaches the
# transfer_to_on_call tool with this destination). Unset = no transfer tool; the prompt
# falls back to create_callback_request. Never commit the real number.
ON_CALL_TRANSFER_NUMBER=
# Optional: let specific real phones resolve to seeded demo customers for live demos.
# Comma-separated <phone>=<customer uuid> pairs. Keep real numbers out of git.
# Example shape (placeholders): +1XXXXXXXXXX=00000000-0000-4000-8000-000000000001
DEMO_CALLER_PHONES=
# Stretch: personalize the greeting via POST /api/vapi/assistant-request. Off by default.
ASSISTANT_REQUEST_ENABLED=false
# The Vapi assistant id (dashboard URL / API). Used by assistant-request and vapi:sync.
VAPI_ASSISTANT_ID=

# Optional: test database used by `npm test` (defaults to postgres://localhost:5432/summit_air_test).
TEST_DATABASE_URL=

# --- Used only by `npm run vapi:sync` on your machine. Do NOT set these on the server. ---
# Vapi PRIVATE API key (Dashboard > API Keys).
VAPI_API_KEY=
# Id of the Vapi Bearer Token credential that holds VAPI_TOOL_SECRET.
VAPI_CREDENTIAL_ID=
