# Copy to .env for local dev. Never commit .env.
DATABASE_URL=postgres://localhost:5432/summit_air_dev
# Shared secret Vapi sends as "Authorization: Bearer <value>" (Vapi Bearer Token credential). 16+ chars.
VAPI_TOOL_SECRET=replace-with-a-long-random-string
# Password for the (future) staff dashboard. 8+ chars.
DASHBOARD_PASSWORD=replace-me-please
# Public base URL of this app (used in Vapi tool configs).
APP_URL=http://localhost:3000
APP_TIMEZONE=America/New_York
# Optional E.164 number for on-call human transfer, e.g. +17185550100.
ON_CALL_TRANSFER_NUMBER=
# Optional: test database used by `npm test` (defaults to postgres://localhost:5432/summit_air_test).
TEST_DATABASE_URL=
