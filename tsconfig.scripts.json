{
  // Compiles one-off Node scripts (db:seed) to CommonJS so they run with plain
  // `node`, without adding a TS runtime dependency. Files reachable from
  // scripts/ must use relative imports (no "@/" alias).
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".scripts-dist",
    "rootDir": "."
  },
  "include": ["scripts/**/*.ts"]
}
